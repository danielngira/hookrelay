# The local Compose demo has a development-only key. Use a random 32-byte value outside the demo.
APP_ENCRYPTION_KEY=hookrelay-local-demo-key-32-byte
DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_HOST=localhost
REDIS_PORT=6379
API_PORT=4000
PG_POOL_SIZE=10
WORKER_CONCURRENCY=10
